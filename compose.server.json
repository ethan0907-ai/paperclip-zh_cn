{
  "name": "paperclip",
  "services": {
    "paperclip": {
      "image": "magic-paperclip:paperclip-runtime-20261001-2",
      "container_name": "paperclip",
      "restart": "unless-stopped",
      "env_file": [
        ".env"
      ],
      "environment": {
        "HOST": "0.0.0.0",
        "PORT": "3100",
        "SERVE_UI": "true",
        "PAPERCLIP_DEPLOYMENT_MODE": "authenticated",
        "PAPERCLIP_DEPLOYMENT_EXPOSURE": "private",
        "PAPERCLIP_AUTH_BASE_URL_MODE": "explicit",
        "PAPERCLIP_PUBLIC_URL": "http://192.168.50.60:3100",
        "PAPERCLIP_ALLOWED_HOSTNAMES": "192.168.50.60,paperclip",
        "PAPERCLIP_MIGRATION_AUTO_APPLY": "true",
        "NODE_EXTRA_CA_CERTS": "/etc/paperclip/hermes-ca.crt"
      },
      "ports": [
        "192.168.50.60:3100:3100"
      ],
      "volumes": [
        "data:/paperclip",
        "/home/magic88ai/paperclip-hermes-gateway/pki/ca.crt:/etc/paperclip/hermes-ca.crt:ro"
      ],
      "networks": {
        "workspace": {
          "gw_priority": 1
        },
        "ai-net": {
          "gw_priority": 0
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "curl",
          "-fsS",
          "http://127.0.0.1:3100/api/health"
        ],
        "interval": "15s",
        "timeout": "5s",
        "retries": 5,
        "start_period": "120s"
      },
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      },
      "depends_on": {
        "hermes-tls": {
          "condition": "service_started"
        }
      }
    },
    "hermes-tls": {
      "image": "nginx:alpine",
      "pull_policy": "never",
      "container_name": "paperclip-hermes-tls",
      "restart": "unless-stopped",
      "network_mode": "container:hermes-business",
      "entrypoint": [
        "nginx"
      ],
      "command": [
        "-g",
        "daemon off;"
      ],
      "read_only": true,
      "tmpfs": [
        "/var/cache/nginx",
        "/var/run",
        "/tmp"
      ],
      "volumes": [
        "/home/magic88ai/paperclip-hermes-gateway/nginx.conf:/etc/nginx/nginx.conf:ro",
        "/home/magic88ai/paperclip-hermes-gateway/pki/server.crt:/etc/nginx/tls/server.crt:ro",
        "/home/magic88ai/paperclip-hermes-gateway/pki/server.key:/etc/nginx/tls/server.key:ro"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "10m",
          "max-file": "3"
        }
      }
    }
  },
  "volumes": {
    "data": {}
  },
  "networks": {
    "workspace": {
      "external": true
    },
    "ai-net": {
      "external": true
    }
  }
}
